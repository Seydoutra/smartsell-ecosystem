{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "out/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_INDEXABLE",
    "NEXT_PUBLIC_MANAGEMENT_URL",
    "NEXT_PUBLIC_ACADEMY_ORIGIN",
    "NEXT_PUBLIC_MEDIA_ORIGIN",
    "NEXT_PUBLIC_STUDIO_ORIGIN",
    "NEXT_PUBLIC_LABS_ORIGIN",
    "NEXT_PUBLIC_BASE_PATH"
  ]
}
