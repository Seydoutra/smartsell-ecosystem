{
  "name": "smartsell-ecosystem",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --concurrency=6",
    "build": "node scripts/build.mjs",
    "typecheck": "turbo run typecheck",
    "test": "tsx --test tests/*.test.ts",
    "check:export": "node scripts/check-export.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "^24",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
